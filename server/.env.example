# BOG — God's Banner of Grace Ministries · Bulk SMS Broadcast Tool
# @file    .env.example
# @author  Bright Da Dev
# @phase   2 — Auth & tenancy
# @purpose Environment contract (names only, no values).

DATABASE_URL="postgresql://user:password@host:port/db?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:port/db"
REDIS_URL="rediss://default:password@host:port"
JWT_SECRET="replace-with-long-random-string"
SMARTSMS_TOKEN="replace-with-smartsms-api-token"
SMARTSMS_SENDER="BOG"
CHURCH_ID="replace-with-uuid"
SMS_RATE_NGN="5"
QUIET_START="21:00"
QUIET_END="07:00"
TZ="Africa/Lagos"

# --- SEED-ONLY: used by prisma/seed.ts on your laptop via temp .env.
# --- NEVER set this on Render. Never commit a real value.
ADMIN_PASSWORD="set-a-strong-temp-password-when-seeding"