// BOG — God's Banner of Grace Ministries · Bulk SMS Broadcast Tool
// @file    prisma/schema.prisma
// @author  Bright Da Dev
// @phase   1 — Skeleton & contracts
// @purpose Full DB schema; church_id on every table; v1.1 enums reserved.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Church {
  id        String  @id @default(uuid())
  name      String
  credits   Int     @default(0)
  users     User[]
  members   Member[]
  groups    Group[]
  campaigns Campaign[]
  optOuts   OptOut[]
  txns      CreditTxn[]
  audits    Audit[]
  templates Template[]
  createdAt DateTime @default(now())
}

model User {
  id        String  @id @default(uuid())
  churchId  String
  church    Church  @relation(fields:[churchId], references:[id])
  email     String  @unique
  name      String
  passHash  String
  campaigns Campaign[] @relation("CreatedBy")
  audits    Audit[]    @relation("Actor")
  @@index([churchId])
}

model Member {
  id            String  @id @default(uuid())
  churchId      String
  church        Church  @relation(fields:[churchId], references:[id])
  name          String
  phone         String
  network       String?
  dnd           Boolean @default(false)
  optedOut      Boolean @default(false)
  lastClassifiedAt DateTime?
  groups        GroupMember[]
  recipients    CampaignRecipient[]
  @@unique([churchId, phone])
  @@index([churchId, dnd, optedOut])
}

model Group {
  id        String  @id @default(uuid())
  churchId  String
  church    Church  @relation(fields:[churchId], references:[id])
  name      String
  members   GroupMember[]
  @@unique([churchId, name])
}

model GroupMember {
  groupId  String
  memberId String
  group    Group  @relation(fields:[groupId], references:[id])
  member   Member @relation(fields:[memberId], references:[id])
  @@id([groupId, memberId])
}

model Template {
  id        String  @id @default(uuid())
  churchId  String
  church    Church  @relation(fields:[churchId], references:[id])
  name      String
  body      String
  @@index([churchId])
}

enum CampaignStatus {
  draft
  scheduled
  sending
  sent
  partially_failed
  failed
  cancelled
}

model Campaign {
  id            String  @id @default(uuid())
  churchId      String
  church        Church  @relation(fields:[churchId], references:[id])
  createdById   String
  createdBy     User    @relation("CreatedBy", fields:[createdById], references:[id])
  title         String
  sender        String
  bodyFinal     String
  segments      Int
  audienceCount Int
  skippedCount  Int
  billableCount Int
  costNgn       Int
  status        CampaignStatus
  scheduledAt   DateTime?
  sentAt        DateTime?
  createdAt     DateTime @default(now())
  refIds        String[]
  recipients    CampaignRecipient[]
  txns          CreditTxn[]
  @@index([churchId, status, createdAt])
}

enum RecipStatus {
  pending
  sent
  delivered
  failed
  skipped_dnd
  skipped_optout
  invalid
}

model CampaignRecipient {
  id         String  @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields:[campaignId], references:[id])
  memberId   String?
  member     Member?  @relation(fields:[memberId], references:[id])
  phone      String
  name       String
  status     RecipStatus
  batchRef   String?
  @@index([campaignId, status])
}

enum OptSource {
  manual
  import
  stop
}

model OptOut {
  id        String  @id @default(uuid())
  churchId  String
  church    Church  @relation(fields:[churchId], references:[id])
  phone     String
  source    OptSource @default(manual)
  addedById String?
  createdAt DateTime @default(now())
  @@unique([churchId, phone])
}

enum TxnType {
  topup
  send_deduction
  refund
  adjustment
  reversal
}

model CreditTxn {
  id          String  @id @default(uuid())
  churchId    String
  church      Church   @relation(fields:[churchId], references:[id])
  campaignId  String?
  campaign    Campaign? @relation(fields:[campaignId], references:[id])
  type        TxnType
  units       Int
  ngn         Int
  balanceAfter Int
  note        String?
  createdAt   DateTime @default(now())
  @@index([churchId, createdAt])
}

model Audit {
  id        String  @id @default(uuid())
  churchId  String
  church    Church  @relation(fields:[churchId], references:[id])
  actorId   String?
  actor     User?   @relation("Actor", fields:[actorId], references:[id])
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
  @@index([churchId, createdAt])
}